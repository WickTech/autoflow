# Optional — enables real LLM summaries. Without it, autoflow uses a
# deterministic extractive summarizer so pipelines run offline / in CI.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# Optional — destination for the webhook sink (Slack/Discord/Teams incoming webhook).
AUTOFLOW_WEBHOOK_URL=""

# Optional — where CI/scheduled-run failures are reported. Set this as a repo
# secret too: a silent pipeline is indistinguishable from a broken one.
AUTOFLOW_ERROR_WEBHOOK_URL=""
