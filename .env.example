# Optional — enables real LLM summaries. Without it, autoflow uses a
# deterministic extractive summarizer so pipelines run offline / in CI.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"

# Bounds on every LLM call. Any failure — timeout, rate limit, budget exhausted —
# degrades to the extractive summarizer rather than failing the run.
AUTOFLOW_LLM_TIMEOUT="30"        # seconds per call
AUTOFLOW_LLM_RETRIES="2"
AUTOFLOW_LLM_MAX_TOKENS="300"    # output cap per summary
AUTOFLOW_LLM_TOKEN_BUDGET="0"    # total tokens per run; 0 = unlimited

# Logging. Diagnostics go to stderr; the console sink's digest stays on stdout.
AUTOFLOW_LOG_LEVEL="INFO"        # DEBUG | INFO | WARNING | ERROR
AUTOFLOW_LOG_FORMAT="text"       # text | json

# Optional — destination for the webhook sink (Slack/Discord/Teams incoming webhook).
AUTOFLOW_WEBHOOK_URL=""

# Optional — where CI/scheduled-run failures are reported. Set this as a repo
# secret too: a silent pipeline is indistinguishable from a broken one.
AUTOFLOW_ERROR_WEBHOOK_URL=""
